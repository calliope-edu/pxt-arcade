// Calliope edition: MakeCode Arcade on Cloudflare, see README.md
{
    "name": "calliope-arcade",
    "main": "worker.js",
    "compatibility_date": "2026-09-01",
    // static editor ("pxt staticpkg --output ..."); deploy with --assets <folder> for another one
    "assets": {
        "directory": "../built/packaged",
        "binding": "ASSETS",
        // serve files exactly by their name, like server/server.js ("/" -> index.html)
        "html_handling": "none",
        "run_worker_first": ["/api/*", "/oauth/*"]
    },
    // shared projects
    "r2_buckets": [
        { "binding": "SCRIPTS", "bucket_name": "calliope-arcade-scripts" }
    ],
    // publishing per IP (Cloudflare allows periods of 10 or 60 seconds); a school class
    // often shares one IP
    "ratelimits": [
        { "name": "PUBLISH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
    ],
    // https://calliope-arcade.<account>.workers.dev; an own address needs its zone in the same
    // Cloudflare account, e.g.
    // "routes": [{ "pattern": "arcade.calliope.cc", "custom_domain": true }],
    "workers_dev": true,
    "vars": {
        "UPSTREAM": "https://www.makecode.com/api/",
        // server/server.js with C++ toolchain for /api/compile/... ("" = MakeCode cloud)
        "COMPILE_API": "",
        // other editor addresses allowed for CORS and GitHub sign-in ("" = any for CORS)
        "ALLOWED_ORIGINS": "",
        "MAX_BODY": "8388608",
        "GITHUB_SCOPE": "repo"
        // GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET: "wrangler secret put ..." (see README.md)
    },
    "observability": { "enabled": true }
}
