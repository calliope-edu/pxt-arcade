// Calliope edition: API worker of MakeCode Arcade on Cloudflare, see README.md. The editor
// itself is the Pages project in pages/, which forwards /api/... and /oauth/... to this worker.
{
    "name": "arcade-api",
    "main": "worker.js",
    "compatibility_date": "2026-09-01",
    // shared projects
    "r2_buckets": [
        { "binding": "SCRIPTS", "bucket_name": "arcade-scripts" }
    ],
    // publishing per IP (Cloudflare allows periods of 10 or 60 seconds); a school class
    // often shares one IP. Rate limiting exists for Workers only, not for Pages.
    "ratelimits": [
        { "name": "PUBLISH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
    ],
    // only reachable through the Pages project (service binding), no address of its own
    "workers_dev": false,
    "preview_urls": false,
    "vars": {
        "UPSTREAM": "https://www.makecode.com/api/",
        // server/server.js with C++ toolchain for /api/compile/... ("" = MakeCode cloud)
        "COMPILE_API": "",
        // other editor addresses allowed for CORS and GitHub sign-in ("" = any for CORS)
        "ALLOWED_ORIGINS": "",
        "MAX_BODY": "8388608",
        "GITHUB_SCOPE": "repo"
        // GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET: "wrangler secret put ..." (see README.md)
    },
    "observability": { "enabled": true }
}
